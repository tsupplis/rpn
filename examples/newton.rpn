# ======================================================================
#  newton.rpn - square root by Newton's method
#
#  Run it:   rpn examples/newton.rpn
#
#  What to observe
#    - real arithmetic: ints promote to reals when needed.
#    - an iteration with a stopping test on the change between two
#      guesses, written with named locals instead of stack gymnastics.
#    - the result is compared with the built-in sqrt.
#
#  Method: to find sqrt(a), improve a guess x with
#      x  <-  (x + a / x) / 2
#  Each step roughly doubles the number of correct digits.
#  Valid for a > 0.
# ======================================================================

function { newton_sqrt
  local { a }
  a local { x }               # first guess: a itself

  label { loop }
  x  a x /  +  2 /  local { nx }      # nx = (x + a / x) / 2
  nx x - abs  1e-12 x>y?      # stack: |nx - x| 1e-12 -> is 1e-12 > change ?
  goto { done }
  drop drop
  nx store { x }
  goto { loop }

  label { done }
  drop drop
  nx
}

2 newton_sqrt                 # 1.41421356237
2 sqrt                        # 1.41421356237  (built in)
9 newton_sqrt                 # 3.0   (a real: the result of a division)
1000000 newton_sqrt           # 1000.0
0.25 newton_sqrt              # 0.5

# the difference to the built-in is far below the display precision
2 newton_sqrt  2 sqrt  -  abs  1e-9  x>y?  1
clear
