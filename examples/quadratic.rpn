# ======================================================================
#  quadratic.rpn - roots of a x^2 + b x + c = 0
#
#  Run it:   rpn examples/quadratic.rpn
#
#  What to observe
#    - local { a b c } names the three coefficients: the formula below
#      reads like the textbook, with no stack juggling at all.
#    - complex numbers are first-class: when the discriminant is
#      negative, sqrt returns a complex number and the same code gives the
#      complex roots.  Nothing in the function tests for that case.
#    - a complex value prints as (re,im).
#    - the function leaves two results: root 1 below, root 2 on top.
#
#      d = sqrt(b^2 - 4 a c)       roots = (-b +- d) / (2 a)
# ======================================================================

function { quadratic
  local { a b c }
  b sq  4 a * c *  -  sqrt  local { d }       # d = sqrt(b^2 - 4ac)
  b neg d +  2 a *  /                         # (-b + d) / 2a
  b neg d -  2 a *  /                         # (-b - d) / 2a
}

1 -3 2 quadratic              # x^2 - 3x + 2       roots 2 and 1
* p
clear

1 0 -2 quadratic              # x^2 - 2            roots +-1.41421356237
* p
clear

1 2 5 quadratic               # x^2 + 2x + 5       roots (-1,2) and (-1,-2)
* p
clear
