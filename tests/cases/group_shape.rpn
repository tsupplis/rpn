# shape errors of the { group } syntax
store x
store { }
store { a b }
# a group may be split over lines; the error is reported where it is found
store { a
b }
# a second item in a one-item group, even if it is a command word
5 store { c
recall { c }
# a lone brace
{
}
# the rest of a line after an error is dropped
goto { a } }
function f
function { }
local { }
local
{ x y
}
setflag { 1 2 }
setflag { 40 }
setflag { two }
# a stray brace
}
{ }
# aliases and long forms are the same atoms
3 sto { aa }
rcl { aa }
setflag { 2 }
sf { 3 }
fs? { 2 } 1
fs? { 3 } 2
